{
	"name": "hexacore-monorepo",
	"version": "1.0.0",
	"private": true,
	"author": "Victor Raúl",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"lint": "biome check ./backend ./frontend",
		"lint:fix": "biome check --write ./backend ./frontend",
		"lint:unsafe": "biome check --write --unsafe ./backend ./frontend",
		"format": "biome format ./backend ./frontend",
		"format:fix": "biome format --write ./backend ./frontend",
		"ci": "biome ci ./backend ./frontend",
		"verify": "pnpm ci && pnpm check:api && pnpm typecheck && pnpm test:backend && pnpm test:frontend && pnpm knip && pnpm check:architecture && pnpm build:frontend",
		"dev": "pnpm --filter backend --filter frontend --parallel dev",
		"dev:backend": "pnpm --filter backend dev",
		"dev:frontend": "pnpm --filter frontend dev",
		"build": "pnpm --filter frontend build",
		"build:frontend": "pnpm --filter frontend build",
		"test:backend": "pnpm --filter backend test",
		"test:frontend": "pnpm --filter frontend test",
		"test:e2e": "pnpm --filter backend test:e2e",
		"typecheck": "pnpm --filter backend --filter frontend exec tsc --noEmit",
		"knip": "DATABASE_URL=${DATABASE_URL:-postgresql://hexacore:cambia_esta_password@localhost:5433/hexacore_db?schema=public} knip",
		"check:architecture": "pnpm --filter backend check:architecture",
		"db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://hexacore:cambia_esta_password@localhost:5433/hexacore_db?schema=public} pnpm --filter backend exec prisma generate",
		"db:push": "pnpm --filter backend exec prisma db push",
		"db:migrate": "pnpm --filter backend exec prisma migrate dev",
		"gen:module": "pnpm --filter backend exec bun scripts/gen-module.ts",
		"gen:api": "pnpm --filter backend exec bun scripts/export-openapi.ts ../node_modules/.cache/openapi.json && openapi-typescript node_modules/.cache/openapi.json --root-types --root-types-no-schema-prefix -o frontend/src/core/api/schema.gen.ts",
		"check:api": "pnpm gen:api && git diff --exit-code frontend/src/core/api/schema.gen.ts"
	},
	"keywords": [],
	"description": "Monorepo Hexacore: backend (Bun + Hono + Prisma) y frontend (Vite + React + TanStack).",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"knip": "6.42.1",
		"openapi-typescript": "7.13.0",
		"typescript": "5.9.3"
	}
}
