# Variables de docker compose (cp .env.example .env). No se suben al repo.
POSTGRES_USER="hexacore"
POSTGRES_PASSWORD="cambia_esta_password"
POSTGRES_DB="hexacore_db"
# Puerto del host para la BD (5433 para no chocar con un Postgres local)
DB_PORT=5433
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia_este_secreto_por_uno_de_32_caracteres_o_mas"
