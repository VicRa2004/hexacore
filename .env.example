# Variables de docker compose (en Dokploy: pestaña Environment). No se suben al repo.
# URL interna de la BD de Dokploy (Database > Internal Connection URL)
DATABASE_URL="postgresql://usuario:password@host:5432/hexacore_db?schema=public"
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia_este_secreto_por_uno_de_32_caracteres_o_mas"
