# Variables de docker compose (en Dokploy: pestaña Environment). No se suben al repo.
# URL interna de la BD de Dokploy (Database > Internal Connection URL)
DATABASE_URL="postgresql://usuario:password@host:5432/hexacore_db?schema=public"
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia_este_secreto_por_uno_de_32_caracteres_o_mas"
# Dominio público de la app (enlaces de los correos), p. ej. https://app.tu-dominio.com
APP_URL="https://app.tu-dominio.com"
# Sin RESEND_API_KEY no se envía ningún correo (recuperar contraseña, verificar email)
RESEND_API_KEY=""
MAIL_FROM="Hexacore <no-reply@tu-dominio.com>"
# DSN de GlitchTip (o Sentry) para backend y web. Vacío: no se reporta nada
SENTRY_DSN=""
# OpenTelemetry (OTLP/HTTP): URL base del colector. Vacío: desactivado
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="hexacore"
OTEL_EXPORTER_OTLP_HEADERS=""
# "true" para enviar trazas desde el navegador por /api/telemetria/v1/traces (requiere OTEL_EXPORTER_OTLP_ENDPOINT)
VITE_OTEL_ENABLED=""
