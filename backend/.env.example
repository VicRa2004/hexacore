# URL de tu PostgreSQL local (ajusta credenciales, host y puerto)
DATABASE_URL="postgresql://hexacore:cambia_esta_password@localhost:5433/hexacore_db?schema=public"
# BD de los tests e2e (pnpm test:e2e). Se BORRA en cada ejecución: nunca la de desarrollo
DATABASE_URL_TEST="postgresql://hexacore:cambia_esta_password@localhost:5433/hexacore_test?schema=public"
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="supersecret_local_key_change_in_prod"
# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGIN="http://localhost:5173"
# "true" solo si el backend está detrás de un proxy de confianza (Traefik/Dokploy):
# el rate limit usará la IP de X-Forwarded-For. En local, déjalo vacío.
TRUST_PROXY=""
# URL pública del frontend (enlaces de recuperar contraseña y verificar email)
APP_URL="http://localhost:5173"
# Envío de correos con Resend. Vacío: los correos se escriben en consola
RESEND_API_KEY=""
MAIL_FROM="Hexacore <no-reply@tu-dominio.com>"
# Archivos subidos (avatares). Sin S3_BUCKET se guardan en disco en STORAGE_DIR
STORAGE_DIR="uploads"
# S3 o compatible (Cloudflare R2: S3_ENDPOINT="https://<cuenta>.r2.cloudflarestorage.com", S3_REGION="auto")
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
