{
	"permissions": {
		"allow": [
			"Bash(pnpm lint)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm verify)",
			"Bash(pnpm test:*)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm knip)",
			"Bash(pnpm check:architecture)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path // empty' | xargs -r pnpm exec biome format --write --no-errors-on-unmatched --files-ignore-unknown=true >/dev/null 2>&1 || true"
					}
				]
			}
		]
	}
}
